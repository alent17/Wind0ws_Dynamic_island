{
  "name": "isle",
  "version": "1.0.11",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "cargo run --manifest-path native/Cargo.toml --bin isle-native --",
    "build": "cargo build --release --manifest-path native/Cargo.toml --bin isle-native",
    "preview": "cargo run --release --manifest-path native/Cargo.toml --bin isle-native --",
    "tauri": "tauri",
    "bundle:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File native/scripts/package-windows.ps1",
    "check": "cargo check --manifest-path native/Cargo.toml --workspace",
    "test": "cargo test --manifest-path native/Cargo.toml --workspace",
    "web:dev": "vite",
    "web:preview": "vite preview",
    "web:build": "vite build",
    "web:check": "svelte-check --tsconfig ./tsconfig.json",
    "web:test": "vitest run",
    "web:bundle:windows": "tauri build --bundles nsis",
    "test:ui": "playwright test",
    "lint": "echo 'No linter configured yet'",
    "format": "cargo fmt --manifest-path native/Cargo.toml --all"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1",
    "@tauri-apps/plugin-http": "^2.5.7",
    "lucide-svelte": "^0.577.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tauri-apps/cli": "^2.10.1",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "svelte": "^5.0.0",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
